# Supabase Client Configuration (Safe for frontend bundle)
# Retrieve these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-client-key

# NOTE: Never put your service_role key or database password in this file or any VITE_* variable.
